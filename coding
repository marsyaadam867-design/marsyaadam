from turtle import *
import math

speed(0)
bgcolor("black")
color("hotpink")
pensize(2)
hideturtle()

for i in range(600):
    # Menggunakan i sebagai variabel yang terus bertambah agar membentuk kurva
    t = i / 20 
    
    # Rumus matematika untuk kurva hati (Heart Shape Curve)
    x = 16 * math.sin(t)**3
    y = 13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t)
    
    penup()
    goto(x * 15, y * 15) # Mengalikan dengan 15 agar ukurannya besar
    pendown()
    
    # Menulis teks "I love you" di tengah hati pada iterasi pertama
    if i == 0:
        write("I love you", align="center", font=("Arial", 12, "bold"))

done()
